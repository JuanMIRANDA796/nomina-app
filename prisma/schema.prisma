// Esquema de NominaX.
//
// Los modelos de la presentación del Comité de Precios y los de Rodaflex
// vivían aquí porque los tres proyectos compartían repositorio. Se retiraron
// el 14 de agosto de 2026, cuando se separaron. Sus tablas siguen existiendo
// vacías en Supabase; se pueden borrar a mano cuando se quiera, pero no hay
// prisa: no las lee nadie. La presentación se mudó a su propio repositorio y
// a su propia base de datos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id             Int     @id @default(autoincrement())
  name           String  @unique
  password       String // In a real app we'd use hashing
  companyName    String?
  businessName   String?
  documentType   String?
  documentNumber String?
  phone          String?
  email          String?
  plan           String  @default("SEMILLA")
  extraEmployees Int     @default(0)

  // DIAN Integration Fields
  nit               String?
  dv                String?
  departmentCode    String?
  cityCode          String?
  taxResponsibility String?

  dianEnabled     Boolean @default(false)
  dianTestSetId   String?
  dianPrefix      String?
  dianStartNumber String?

  employees          Employee[]
  holidays           Holiday[]
  payrollSubmissions PayrollSubmission[]
  configs            PayrollConfig[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Employee {
  id        Int     @id @default(autoincrement())
  companyId Int     @default(1)
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  cedula    String
  cargo     String
  salary    Float
  phone     String?

  // DIAN Integration Fields
  contractType  String? @default("1") // 1: Termino fijo, 2: Indefinido...
  workerType    String? @default("01") // 01: Dependiente
  workerSubtype String? @default("00") // 00: No aplica
  email         String?
  paymentMethod String? @default("1") // 1: Contado
  paymentMeans  String? @default("10") // 10: Efectivo

  riskClass          String              @default("I") // I, II, III, IV, V
  status             String              @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  attendances        Attendance[]
  absences           Absence[]
  payrollSubmissions PayrollSubmission[]

  @@unique([companyId, cedula])
}

model Attendance {
  id         Int       @id @default(autoincrement())
  employeeId Int
  employee   Employee  @relation(fields: [employeeId], references: [id])
  date       DateTime // The date of the shift (without time)
  entryTime  DateTime? // Full timestamp
  exitTime   DateTime? // Full timestamp
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

model Absence {
  id             Int      @id @default(autoincrement())
  employeeId     Int
  employee       Employee @relation(fields: [employeeId], references: [id])
  date           DateTime
  reason         String // e.g., "Incapacidad médica", "Vacaciones"
  paidPercentage Float    @default(0) // 0.0 to 1.0 (e.g. 0.6667)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([employeeId, date])
}

model Holiday {
  id        Int     @id @default(autoincrement())
  companyId Int     @default(1)
  company   Company @relation(fields: [companyId], references: [id])
  date      DateTime
  name      String

  @@unique([companyId, date])
}

model PayrollConfig {
  id          Int     @id @default(autoincrement())
  companyId   Int     @default(1)
  company     Company @relation(fields: [companyId], references: [id])
  key         String // e.g., "AUX_TRANSPORTE", "SMLV"
  value       String // e.g., "162000"
  description String?

  @@unique([companyId, key])
}

model PayrollSubmission {
  id         Int      @id @default(autoincrement())
  companyId  Int
  company    Company  @relation(fields: [companyId], references: [id])
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       DateTime // Mes/Ano de la nomina
  cune       String?  @unique
  trackId    String?  @unique
  status     String   @default("PENDING") // PENDING, SUCCESS, ERROR
  pdfUrl     String?
  xmlUrl     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId, employeeId, date])
}
